PROJECT_NAME="TalentPulse AI Recruitment Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Authentication
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Managed PostgreSQL (Neon, Supabase, Render, AWS RDS):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Local fallback (SQLite):
# DATABASE_URL="sqlite:///./recruitment.db"

# CORS Configuration (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","https://your-talentpulse-app.vercel.app"]'

# Storage & Upload Security
UPLOAD_DIR="./uploads/resumes"
MAX_UPLOAD_SIZE_MB=15

# Google Gemini AI Screening Engine (Optional — uses deterministic rubric fallback when omitted)
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
